# Copy to `.env` and adjust locally. `.env` is git-ignored and must never be
# committed. Every value below is a development placeholder, not a secret.

NODE_ENV=development
PORT=3000

# Development database (docker-compose.yml service `postgres`).
DATABASE_URL=postgres://salon:salon@127.0.0.1:5432/salon

# Test database. Truncated before each test file (decision D-7), so it must not
# hold data worth keeping. `tests/setup.ts` refuses a URL whose database name
# does not end in `_test`.
TEST_DATABASE_URL=postgres://salon:salon@127.0.0.1:5432/salon_test

# HS256 signing key for access tokens (bearerAuth in openapi.yaml).
# Placeholder: generate a real value locally before running the server, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Access-token lifetime in seconds; surfaced to clients as LoginResponse.expiresIn.
JWT_EXPIRES_IN=3600

# Origin of the client pages, used in Appointment.confirmationUrl (the SMS link,
# REQ-F-005). Defaults to http://localhost:<PORT>; set it to the public address
# when the server is reached under another host name.
# PUBLIC_BASE_URL=http://localhost:3000

# Directory for the JSONL application log. Git-ignored.
LOG_DIR=logs/runtime
