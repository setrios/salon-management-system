{
  "name": "salon-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the Salon Management System, implemented against the OpenAPI contract approved at API-GATE (2026-10-26).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "npm run convert:contract && tsc -p tsconfig.json && node scripts/copy-contract.mjs",
    "dev": "npm run build && node --watch --env-file-if-exists=.env dist/src/index.js",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "test": "vitest run",
    "lint:contract": "npm --prefix spec/api run lint",
    "verify:contract": "node scripts/verify-contract.mjs",
    "check:test-first": "node scripts/check-test-first.mjs",
    "convert:contract": "node src/contract/convert.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.5",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "supertest": "^7.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.2",
    "vitest": "^4.1.12"
  }
}
